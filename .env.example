# Copie este arquivo para .env.local e preencha o que já existir.
# Tudo é opcional: sem nenhuma variável a página funciona normalmente.

# --- Rastreamento (obrigatório antes de subir campanha) ---
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=

# --- Destino dos leads do formulário ---
# URL de webhook do CRM, n8n, Make, Zapier ou Google Apps Script.
# Sem essa variável o lead ainda chega, porque o formulário abre o WhatsApp.
LEAD_WEBHOOK_URL=
